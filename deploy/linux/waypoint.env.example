# Copied to /etc/waypoint/waypoint.env by install.sh, readable only by root and the waypoint group.

# The server's Tailscale address, from `tailscale ip -4`. Until it's set, the server only answers on this machine.
# Use the IP address, not a name: a name such as the MagicDNS one listens on every network, so it's refused,
# like every network at once (0.0.0.0), unless Waypoint__AllowAllInterfaces=true is also set.
# Plain HTTP anywhere but this machine or Tailscale (100.64.0.0/10, fd7a:115c:a1e0::/48), such as a home network
# address, is refused as well unless Waypoint__AllowPublicHttp=true, and then warned about at every start.
Waypoint__Listen=http://127.0.0.1:5280

# The zone reminders are meant for. Unset, it's the system's own zone. The server warns in the log when the
# system clock is set to another one.
# Waypoint__TimeZone=America/Chicago

# A link that's pinged every few minutes while reminders are running, such as a healthchecks.io check.
# Set healthchecks.io to notify your phone when pings stop, so a dead server is noticed from outside it.
Waypoint__HeartbeatUrl=
Waypoint__HeartbeatMinutes=5

# Only if the claude sign-in doesn't last unattended: the token from
#   sudo -u waypoint -H bash -lc 'claude setup-token'
# Waypoint keeps it when it runs claude, and still removes ANTHROPIC_API_KEY, so nothing is billed to an API key.
# CLAUDE_CODE_OAUTH_TOKEN=
