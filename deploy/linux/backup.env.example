# Copied to /etc/waypoint/backup.env by install.sh. Root only.

# Your age public key, from `age-keygen -o waypoint-backup.key` run on another machine. Keep that key file off the
# server, in a password manager or on paper, since it's the only way to read the backups.
AGE_RECIPIENT=

# The second location: a USB drive mounted here, or any other disk. RAID isn't a backup, so use a separate disk.
# The backup runs as the waypoint user with the waypoint-backup group, so give that group the folder:
#   sudo chgrp waypoint-backup /mnt/waypoint-backup && sudo chmod 2770 /mnt/waypoint-backup
# Use a Linux file system such as ext4. A FAT or exFAT drive has to be mounted with gid=waypoint-backup,umask=007.
BACKUP_DIR=/mnt/waypoint-backup
# Set to no if BACKUP_DIR is a plain folder rather than a mount point.
BACKUP_DIR_IS_MOUNT=yes
KEEP_DAYS=30

# Optional: also copy each encrypted file off the machine with rclone, such as RCLONE_REMOTE=b2:waypoint-backups.
RCLONE_REMOTE=

# Optional: a second healthchecks.io check pinged after each good backup, so a stopped backup is noticed too.
BACKUP_PING_URL=
