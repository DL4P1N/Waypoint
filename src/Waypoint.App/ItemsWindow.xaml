<Window x:Class="Waypoint.App.ItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="clr-namespace:Waypoint.Core.Capture;assembly=Waypoint.Core"
        xmlns:local="clr-namespace:Waypoint.App"
        Title="Waypoint"
        Width="1280"
        Height="780"
        MinWidth="1040"
        MinHeight="480"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{StaticResource Rule}"
        BorderThickness="1"
        Style="{StaticResource AppWindow}"
        Closing="OnClosing"
        SizeChanged="OnSizeChanged"
        PreviewKeyDown="OnShortcutKey">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <DockPanel>
        <Border x:Name="TopBar"
                DockPanel.Dock="Top"
                Height="64"
                BorderBrush="{StaticResource Rule}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TodayLabel"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}" />
                    <!-- While a change is on its way to a slow server. The window carries on meanwhile. -->
                    <TextBlock x:Name="SavingLabel"
                               FontSize="12"
                               Text="Saving..."
                               Foreground="{DynamicResource SecondaryText}"
                               Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="NextClassPanel"
                            Margin="0,0,64,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="NextClassName"
                               HorizontalAlignment="Right"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}" />
                    <TextBlock x:Name="NextClassDetails"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryText}"
                               Effect="{StaticResource TextHalo}" />
                </StackPanel>
                <!-- Shown the whole time a lecture records, on every page, so recording is never hidden. -->
                <StackPanel x:Name="RecordingBar"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Recording">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource Urgent}" />
                        <TextBlock x:Name="RecordingTime"
                                   MinWidth="104"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}"
                                   Text="Recording 0:00" />
                        <ProgressBar x:Name="RecordingLevel"
                                     Width="56"
                                     Height="6"
                                     Margin="4,0,12,0"
                                     VerticalAlignment="Center"
                                     Maximum="1"
                                     ToolTip="Sound level"
                                     AutomationProperties.Name="Sound level" />
                        <TextBox x:Name="MarkLine"
                                 Width="190"
                                 Padding="8,4"
                                 FontSize="12"
                                 Style="{StaticResource FieldBox}"
                                 Tag="Type a line to mark it"
                                 AutomationProperties.Name="Line to mark"
                                 PreviewKeyDown="OnMarkLineKeyDown" />
                        <Button Margin="6,0,0,0" Padding="10,4" Content="Mark" ToolTip="Flag this moment as one that matters (Ctrl+Alt+M)" Click="OnMarkClicked" />
                        <Button Margin="6,0,0,0" Padding="10,4" Content="Stop" ToolTip="Stop recording and make notes" Click="OnStopRecordingClicked" />
                    </StackPanel>
                    <TextBlock x:Name="RecordingNote"
                               MaxWidth="560"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryText}" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Width="48"
                        BorderThickness="0"
                        FontSize="15"
                        Content="×"
                        ToolTip="Close window"
                        AutomationProperties.Name="Close window"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClicked" />
            </Grid>
        </Border>

        <Border x:Name="StatusBar"
                DockPanel.Dock="Top"
                Padding="28,8"
                Background="{StaticResource Surface}"
                Visibility="Collapsed">
            <!-- One line, so a long message doesn't push every page down. The whole of it is in the tip. -->
            <DockPanel>
                <!-- Only for a file found damaged and set aside, so its notice can go once it's been seen. -->
                <Button x:Name="StatusDismiss"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource LinkButton}"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Dismiss the notice about files that couldn't be read"
                        Click="OnStatusDismissClicked">
                    <TextBlock FontSize="12" TextDecorations="Underline" Text="Dismiss" Foreground="{DynamicResource Accent}" />
                </Button>
                <Button x:Name="StatusOpen"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource LinkButton}"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Open what couldn't be saved on the server"
                        Click="OnStatusOpenClicked">
                    <TextBlock FontSize="12" TextDecorations="Underline" Text="Open" Foreground="{DynamicResource Accent}" />
                </Button>
                <TextBlock x:Name="Status"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           Foreground="{DynamicResource SecondaryText}"
                           Effect="{StaticResource TextHalo}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="*" MinWidth="560" />
                <ColumnDefinition x:Name="AskWidth" Width="320" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <ListBox x:Name="Menu"
                             Margin="8,18,8,0"
                             Style="{StaticResource PlainList}"
                             ItemContainerStyle="{StaticResource PickRow}"
                             AutomationProperties.Name="Pages"
                             SelectionChanged="OnPageChosen">
                        <ListBoxItem Content="To do" ToolTip="To do (Ctrl+1)" AutomationProperties.AcceleratorKey="Ctrl+1" />
                        <ListBoxItem Content="Notes" ToolTip="Notes and lists (Ctrl+2)" AutomationProperties.AcceleratorKey="Ctrl+2" />
                        <ListBoxItem Content="Budget" ToolTip="Budget (Ctrl+3)" AutomationProperties.AcceleratorKey="Ctrl+3" />
                        <ListBoxItem Content="History" ToolTip="History (Ctrl+4)" AutomationProperties.AcceleratorKey="Ctrl+4" />
                        <ListBoxItem Content="Settings" ToolTip="Settings (Ctrl+5)" AutomationProperties.AcceleratorKey="Ctrl+5" />
                    </ListBox>
                    <!-- Find anywhere searches every page at once. Ctrl+K opens it from anywhere in the window. -->
                    <Button x:Name="FindButton"
                            Margin="8,10,8,0"
                            Padding="11,6"
                            HorizontalContentAlignment="Left"
                            Style="{StaticResource PageAction}"
                            ToolTip="Search every page at once (Ctrl+K)"
                            AutomationProperties.Name="Find anywhere"
                            AutomationProperties.AcceleratorKey="Ctrl+K"
                            Click="OnFindClicked">
                        <StackPanel>
                            <TextBlock Text="Find anywhere" />
                            <TextBlock FontSize="12" Text="Ctrl+K" Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <local:TodayView x:Name="TodayPage" />
                <local:NotesView x:Name="NotesPage" Visibility="Collapsed" />
                <local:BudgetView x:Name="MoneyPage" Visibility="Collapsed" />
                <local:HistoryView x:Name="HistoryPage" Visibility="Collapsed" />
                <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
                <local:FindView x:Name="FindPage" Visibility="Collapsed" />
            </Grid>

            <Border x:Name="AskColumn"
                    Grid.Column="2"
                    BorderBrush="{StaticResource Rule}"
                    BorderThickness="1,0,0,0"
                    Background="Transparent"
                    AllowDrop="True"
                    PreviewDragEnter="OnFileDragOver"
                    PreviewDragOver="OnFileDragOver"
                    PreviewDragLeave="OnFileDragLeave"
                    PreviewDrop="OnFileDrop">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="24,22,24,16"
                               Style="{StaticResource ColumnTitle}"
                               Text="Ask" />

                    <Border x:Name="PayCard"
                            DockPanel.Dock="Top"
                            Margin="24,0,24,14"
                            Padding="14,11"
                            Background="{StaticResource Surface}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="2,0,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="PayCardText"
                                       FontSize="13"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryText}" />
                            <WrapPanel>
                                <Button Margin="0,8,6,0" Padding="10,5" Content="Use these" Tag="use these" Click="OnSessionWordClicked" />
                                <Button Margin="0,8,6,0" Padding="10,5" Content="{x:Static capture:CardLabels.Skip}" Tag="not these" Click="OnSessionWordClicked" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SessionCard"
                            DockPanel.Dock="Top"
                            Margin="24,0,24,14"
                            Padding="14,11"
                            Background="{StaticResource Surface}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="2,0,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="SessionTask"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryText}" />
                            <TextBlock x:Name="SessionAction"
                                       Margin="0,3,0,6"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryText}" />
                            <WrapPanel>
                                <Button Margin="0,4,6,0" Padding="10,5" Content="Did it" Tag="did it" Click="OnSessionWordClicked" />
                                <Button Margin="0,4,6,0" Padding="10,5" Content="Make it smaller" Tag="smaller" ToolTip="Asks Claude for a smaller step. If that takes too long, a ready one is used." Click="OnSessionWordClicked" />
                                <Button Margin="0,4,6,0" Padding="10,5" Content="{x:Static capture:CardLabels.Pause}" Tag="not now" ToolTip="Your place is kept. Say resume when you're ready." Click="OnSessionWordClicked" />
                                <Button Margin="0,4,6,0" Padding="10,5" Content="End" ToolTip="Stop this session without marking anything done" Click="OnSessionEndClicked" />
                                <Button x:Name="TrialButton" Margin="0,4,6,0" Padding="10,5" Content="2 minutes" Tag="2 minutes" Visibility="Collapsed" Click="OnSessionWordClicked" />
                                <Button x:Name="OpenWorkButton" Margin="0,4,6,0" Padding="10,5" Content="Open the work" Visibility="Collapsed" Click="OnOpenWorkClicked" />
                            </WrapPanel>
                            <local:FeedbackPrompt x:Name="SessionFeedback" />
                        </StackPanel>
                    </Border>

                    <!-- Something put off with "after this", brought back once when Ask or To do opens, or after Did it. -->
                    <Border x:Name="AfterThisCard"
                            DockPanel.Dock="Top"
                            Margin="24,0,24,14"
                            Padding="14,11"
                            Background="{StaticResource Surface}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="2,0,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AfterThisLine"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource PrimaryText}" />
                            <WrapPanel>
                                <Button Margin="0,8,6,0" Padding="10,5" Content="Start" ToolTip="Start on this, one tiny action at a time" Click="OnAfterThisStartClicked" />
                                <Button Margin="0,8,6,0" Padding="10,5" Content="{x:Static capture:CardLabels.NotNow}" ToolTip="It stays on your list, and this won't come back on its own" Click="OnAfterThisNotNowClicked" />
                            </WrapPanel>
                            <local:FeedbackPrompt x:Name="AfterThisFeedback" />
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            Margin="24,8,24,22"
                            Padding="14,11"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Surface}" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBlock x:Name="Placeholder"
                                       FontSize="14"
                                       Text="Ask anything"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Effect="{StaticResource TextHalo}"
                                       IsHitTestVisible="False" />
                            <TextBox x:Name="Input"
                                     AutomationProperties.Name="Ask"
                                     AutomationProperties.HelpText="Ask anything"
                                     FontSize="14"
                                     Padding="-2,0,0,0"
                                     BorderThickness="0"
                                     MaxHeight="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     Foreground="{StaticResource PrimaryText}"
                                     CaretBrush="{DynamicResource Accent}"
                                     SelectionBrush="{DynamicResource Accent}"
                                     TextChanged="OnInputChanged"
                                     PreviewKeyDown="OnInputKeyDown" />
                        </Grid>
                    </Border>

                    <!-- The examples again, once the chat has moved past them. Shown only while the box is empty. -->
                    <Button x:Name="ThingsToTry"
                            DockPanel.Dock="Bottom"
                            Margin="24,8,24,0"
                            Padding="0,2"
                            Style="{StaticResource LinkButton}"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Things to try"
                            Click="OnThingsToTryClicked">
                        <TextBlock FontSize="12" Text="Things to try" Foreground="{DynamicResource SecondaryText}" />
                    </Button>

                    <!-- Messages typed here that are waiting, said once, here, rather than across every page. The detail
                         of a failure goes to errors.log. -->
                    <Border x:Name="SortNotice"
                            DockPanel.Dock="Bottom"
                            Margin="24,8,24,0"
                            Padding="12,8,4,8"
                            Background="{StaticResource Surface}"
                            AutomationProperties.Name="Sorting status"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="SortNoticeClose"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource SmallButton}"
                                    Content="×"
                                    FontSize="13"
                                    ToolTip="Hide this"
                                    AutomationProperties.Name="Hide this"
                                    Click="OnSortNoticeClosed" />
                            <StackPanel>
                                <TextBlock x:Name="SortNoticeText"
                                           FontSize="12"
                                           LineHeight="17"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryText}" />
                                <Button x:Name="SortRetry"
                                        Margin="0,4,0,0"
                                        Padding="0,2"
                                        Style="{StaticResource LinkButton}"
                                        Cursor="Hand"
                                        AutomationProperties.Name="Try again"
                                        Click="OnSortRetryClicked">
                                    <TextBlock FontSize="12" TextDecorations="Underline" Text="Try again" Foreground="{DynamicResource Accent}" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="Chat" Margin="24,0,24,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="{Binding Inset}"
                                                MaxWidth="248"
                                                HorizontalAlignment="{Binding Alignment}"
                                                Background="{Binding Fill}">
                                            <StackPanel>
                                                <TextBlock FontSize="{Binding TextSize}"
                                                           LineHeight="19"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Text}"
                                                           Foreground="{Binding TextBrush}" />
                                                <ItemsControl ItemsSource="{Binding Links}" Visibility="{Binding LinksVisibility}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource LinkButton}"
                                                                    Padding="0,2"
                                                                    Cursor="Hand"
                                                                    Click="OnChatLinkClicked">
                                                                <TextBlock FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           TextDecorations="Underline"
                                                                           Text="{Binding Label}"
                                                                           Foreground="{DynamicResource Accent}" />
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- Over the chat, so its examples can be clicked. Each one fills the box, ready to send or change. -->
                        <StackPanel x:Name="ChatHint" Margin="24,0">
                            <TextBlock Margin="0,0,0,8"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Text="Add, change, or ask anything. Click one to try it:"
                                       Foreground="{DynamicResource SecondaryText}" />
                            <ItemsControl x:Name="Examples" AutomationProperties.Name="Things to try">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}"
                                                Padding="0,3"
                                                Cursor="Hand"
                                                AutomationProperties.Name="{Binding}"
                                                Click="OnExampleClicked">
                                            <TextBlock FontSize="13" TextDecorations="Underline" Text="{Binding}" Foreground="{DynamicResource SecondaryText}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
