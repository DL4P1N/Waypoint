<UserControl x:Class="Waypoint.App.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Waypoint.App">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <local:NestedColumn x:Name="Column" SearchHint="Search history" AddMode="None" />

        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="28,22,24,12" MinHeight="34">
                <TextBlock x:Name="PageTitle"
                           VerticalAlignment="Center"
                           Style="{StaticResource ColumnTitle}"
                           Text="History" />
            </Grid>
            <local:UndoBar x:Name="Bar" DockPanel.Dock="Top" Margin="28,0,24,12" />
            <Grid>
                <TextBlock x:Name="Empty"
                           Margin="28,0"
                           VerticalAlignment="Top"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Text="Nothing here yet."
                           Foreground="{DynamicResource SecondaryText}"
                           Visibility="Collapsed" />
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Entries" Margin="28,0,24,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10" Background="Transparent" ContextMenuOpening="OnRowMenuOpening">
                                    <CheckBox DockPanel.Dock="Left"
                                              Style="{StaticResource DoneBox}"
                                              Margin="0,2,11,0"
                                              VerticalAlignment="Top"
                                              IsChecked="True"
                                              AutomationProperties.Name="{Binding ReopenName}"
                                              ToolTip="Uncheck to put it back on To do"
                                              Visibility="{Binding BoxVisibility}"
                                              Unchecked="OnRowUnchecked" />
                                    <StackPanel>
                                        <TextBlock FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Title}"
                                                   TextDecorations="{Binding Strike}"
                                                   Foreground="{DynamicResource FinishedText}" />
                                        <TextBlock FontSize="12"
                                                   Text="{Binding Details}"
                                                   Foreground="{DynamicResource FinishedDetail}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
