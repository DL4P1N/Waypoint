<UserControl x:Class="Waypoint.App.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Waypoint.App">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <local:NestedColumn x:Name="Column" SearchHint="Search history" AddMode="None" />

        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top" Margin="28,22,24,12" MinHeight="34">
                <TextBlock x:Name="PageTitle"
                           VerticalAlignment="Center"
                           Style="{StaticResource ColumnTitle}"
                           Text="History" />
            </Grid>
            <local:UndoBar x:Name="Bar" DockPanel.Dock="Top" Margin="28,0,24,12" />
            <Grid>
                <TextBlock x:Name="Empty"
                           Margin="28,0"
                           VerticalAlignment="Top"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Text="Nothing here yet."
                           Foreground="{DynamicResource SecondaryText}"
                           Visibility="Collapsed" />
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Entries" Margin="28,0,24,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,10" Background="Transparent" ContextMenuOpening="OnRowMenuOpening" PreviewKeyDown="OnRowKey">
                                    <!-- The row's menu without a right-click, and a stop for the keyboard on every row, even one
                                         that can't be put back and so has no box. Shows while the row is pointed at or has focus. -->
                                    <Button DockPanel.Dock="Right"
                                            Margin="8,0,0,0"
                                            MinWidth="28"
                                            MinHeight="24"
                                            Padding="8,0"
                                            VerticalAlignment="Top"
                                            FontSize="16"
                                            Content="&#x22EF;"
                                            ToolTip="More for this item"
                                            AutomationProperties.Name="{Binding MenuName}"
                                            Click="OnRowMenuClicked">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                                <Setter Property="Opacity" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <CheckBox DockPanel.Dock="Left"
                                              Style="{StaticResource DoneBox}"
                                              Margin="0,2,11,0"
                                              VerticalAlignment="Top"
                                              IsChecked="True"
                                              AutomationProperties.Name="{Binding ReopenName}"
                                              ToolTip="Uncheck to put it back on To do"
                                              Visibility="{Binding BoxVisibility}"
                                              Unchecked="OnRowUnchecked" />
                                    <StackPanel>
                                        <TextBlock FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Title}"
                                                   TextDecorations="{Binding Strike}"
                                                   Foreground="{DynamicResource FinishedText}" />
                                        <TextBlock FontSize="12"
                                                   Text="{Binding Details}"
                                                   Foreground="{DynamicResource FinishedDetail}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
