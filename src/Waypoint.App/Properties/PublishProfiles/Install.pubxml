<?xml version="1.0" encoding="utf-8"?>
<!-- How Waypoint is built to install: one small exe that uses the installed .NET 10 Desktop runtime, compiled ahead
     of time so it starts with less work. dotnet publish src\Waypoint.App -p:PublishProfile=Install -o <folder> -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>