<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Waypoint.Core\Waypoint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parses note Markdown. MarkdownDocument.cs turns it into a FlowDocument with the theme's brushes. -->
    <PackageReference Include="Markdig" Version="1.4.2" />
    <!-- Reads imported recordings with Windows Media Foundation and writes the 16 kHz WAV Whisper needs. See MediaFoundationAudio.cs. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\waypoint.ico" LogicalName="waypoint.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Waypoint</AssemblyName>
    <ApplicationIcon>Assets\waypoint.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
