<Window x:Class="Waypoint.App.RecordOfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Waypoint.App"
        Style="{StaticResource AppWindow}"
        Title="Record this class?"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{DynamicResource Accent}"
        BorderThickness="1">
    <StackPanel Margin="20,16">
        <TextBlock Style="{StaticResource SectionHeading}" Text="Class is starting" ToolTip="{x:Static local:CornerCards.KeyHint}" />
        <TextBlock x:Name="Question"
                   Margin="0,6,0,2"
                   FontSize="18"
                   FontWeight="Light"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource PrimaryText}" />
        <TextBlock FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Nothing records unless you choose Record. Keep the lid open while recording, since closing it puts the PC to sleep." />
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="RecordButton" IsDefault="True" Padding="16,7" Margin="0,4,8,0" Content="Record" Click="OnRecordClicked" />
            <Button Padding="16,7" Margin="0,4,8,0" Content="Not now" Click="OnNotNowClicked" />
        </WrapPanel>
    </StackPanel>
</Window>
