<Application x:Class="Waypoint.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- The tint over the acrylic behind every window and menu. ThemeBrushes sets it from the theme. Surfaces and rules are white over it. -->
        <SolidColorBrush x:Key="WindowBackground" Color="#80141414" />
        <SolidColorBrush x:Key="InputBackground" Color="#15000000" />
        <SolidColorBrush x:Key="Surface" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="SurfaceHover" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryText" Color="#D4D4D4" />
        <SolidColorBrush x:Key="Rule" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#D0D0D0" />
        <SolidColorBrush x:Key="Urgent" Color="#FF7A70" />
        <SolidColorBrush x:Key="Soon" Color="#FFC857" />
        <SolidColorBrush x:Key="MoneyMark" Color="#6FD08C" />
        <SolidColorBrush x:Key="QuietMark" Color="#8A8A8A" />
        <SolidColorBrush x:Key="FinishedText" Color="#C8C8C8" />
        <SolidColorBrush x:Key="FinishedDetail" Color="#C8C8C8" />
        <!-- A soft dark edge around gray text, like desktop icon labels. It can't be seen over dark content, and keeps
             headings, labels and hints readable when something bright is behind the blur. -->
        <DropShadowEffect x:Key="TextHalo" ShadowDepth="0" BlurRadius="2" Color="#000000" Opacity="0.9" RenderingBias="Performance" />

        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="{DynamicResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every window's font, so corner cards and Ask Waypoint read the same as the main window. -->
        <Style x:Key="AppWindow" TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>

        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
        </Style>

        <!-- A heading over a group of rows, such as "Safe to spend today" or a day on To do. Sentence case, never capitals. -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            <Setter Property="Effect" Value="{StaticResource TextHalo}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <!-- The button Enter presses is filled with the accent, so the main action stands out from Cancel. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="#000000" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsDefault" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource PrimaryText}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryText}" />
                            </MultiTrigger>
                            <!-- Last, so a button that can't be pressed yet reads as resting even when it's the one Enter
                                 would press: quiet text, a faint rule and no fill, like NoteToolbar's. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
                                <Setter Property="Foreground" Value="{DynamicResource QuietMark}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
        </Style>

        <!-- A page-level action above the content, such as Budget's "Set a balance". Rows still act through right-click. -->
        <Style x:Key="PageAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <!-- The content host applies Padding itself, so the hint has to match it. Typed text
                                     also starts 2px further in, so the hint does too and the caret sits before it. -->
                                <Border x:Name="Hint"
                                        Padding="{TemplateBinding Padding}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                    <TextBlock Margin="2,0,0,0"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               Effect="{StaticResource TextHalo}" />
                                </Border>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Words that read like a TextBlock but can be selected and copied, such as Ask's replies. Not a Tab stop. -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- A plain host, not a ScrollViewer, so the mouse wheel over the words still scrolls what they're in.
                             Typed text keeps 2px of its own inset, taken back so the words line up as a TextBlock's would. -->
                        <Decorator x:Name="PART_ContentHost" Margin="-2,0,-2,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The note editor and the token box frame themselves like FieldBox: a rule, and the accent while typing,
             instead of the system's blue hover and focus borders. -->
        <Style x:Key="RichFieldBox" TargetType="RichTextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordFieldBox" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <!-- The selected row gets a bar and heavier text, so it doesn't rely on color alone. -->
        <!-- Rows and choices are named after what they show, from the item's ToString, so a screen reader reads words. -->
        <Style x:Key="PickRow" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Margin="0,0,0,2"
                                Padding="11,8"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row of small choices in a form, one picked at a time. The pick gets a border and heavier text, not just color. -->
        <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource PlainList}">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chip"
                                            Margin="0,0,6,6"
                                            Padding="9,4"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource Rule}"
                                            BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Surface}" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="15"
                                    Height="15"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Top"
                                    BorderBrush="#8A8A8A"
                                    BorderThickness="1"
                                    Background="Transparent">
                                <!-- A tick, black on the accent, so a checked box reads as checked and not just filled. -->
                                <Path x:Name="Mark"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 4 L 3 7 L 9 0"
                                      Stroke="#000000"
                                      StrokeThickness="1.6"
                                      SnapsToDevicePixels="True"
                                      Visibility="Collapsed" />
                            </Border>
                            <!-- The gap between the box and its words is here, so no box needs its own. -->
                            <ContentPresenter x:Name="Words" Grid.Column="1" Margin="10,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Words" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A finished item: an X in an empty box, so it reads as done without any color. -->
        <Style x:Key="DoneBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="15"
                                    Height="15"
                                    Margin="0,3,0,0"
                                    VerticalAlignment="Top"
                                    BorderBrush="#8A8A8A"
                                    BorderThickness="1"
                                    Background="Transparent">
                                <Path x:Name="Cross"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 7 7 M 7 0 L 0 7"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.4"
                                      SnapsToDevicePixels="True"
                                      Visibility="Collapsed" />
                            </Border>
                            <!-- The gap between the box and its words is here, so no box needs its own. -->
                            <ContentPresenter x:Name="Words" Grid.Column="1" Margin="10,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Words" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One of a few choices, such as where Record a lecture listens: a ring like the check box's frame, with a
             dot that reads as picked without any color. -->
        <Style TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="15" Height="15" Margin="0,3,0,0" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring" Stroke="#8A8A8A" StrokeThickness="1" Fill="Transparent" />
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter x:Name="Words" Grid.Column="1" Margin="10,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="Words" Property="Margin" Value="0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border MinWidth="190"
                                Padding="0,4"
                                Background="{DynamicResource WindowBackground}"
                                BorderBrush="{DynamicResource Rule}"
                                BorderThickness="1">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="0,4" Background="{DynamicResource Rule}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The highlighted row gets a bar as well as a fill, as the side menu does. The arrow keys move the same
             bar, since a menu row with keyboard focus is marked like one under the mouse, so it needs no ring. -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Row"
                                    Padding="11,6,12,6"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="3,0,0,0">
                                <DockPanel>
                                    <Path x:Name="Arrow"
                                          DockPanel.Dock="Right"
                                          Margin="18,0,0,0"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 0 8"
                                          Stroke="#9A9A9A"
                                          StrokeThickness="1.2"
                                          Visibility="Collapsed" />
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                                </DockPanel>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Right"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="None"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="150"
                                        Padding="0,4"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource Rule}"
                                        BorderThickness="1">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A plain list of rows or buttons is never a Tab stop itself, so Tab goes straight to what's in it rather
             than stopping on the list with a dotted box. Lists you pick from are ListBoxes, and keep theirs. -->
        <Style TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource Rule}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Row" Padding="0,11" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                <Path x:Name="Chevron"
                                      Grid.Column="1"
                                      Margin="12,0,2,0"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0"
                                      Stroke="#9A9A9A"
                                      StrokeThickness="1.2"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="Turn" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ToggleButton Style="{StaticResource SectionToggle}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}" />
                                <ContentPresenter x:Name="Body" Margin="0,0,0,12" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin thumb that grows to 8 px under the mouse or while dragged, so it's easy to catch. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Width="4" HorizontalAlignment="Right" Background="#3AFFFFFF" />
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="8" />
                                                    <Setter TargetName="Bar" Property="Background" Value="#5AFFFFFF" />
                                                </DataTrigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bar" Property="Width" Value="8" />
                                                    <Setter TargetName="Bar" Property="Background" Value="#5AFFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
