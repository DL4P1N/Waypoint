<Window x:Class="Waypoint.App.AudioImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make notes from a recording"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{DynamicResource Rule}"
        BorderThickness="1"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="18">
        <TextBlock x:Name="Question"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryText}" />
        <TextBlock x:Name="Detail"
                   Margin="0,6,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}" />
        <TextBlock x:Name="DownloadText"
                   Margin="0,10,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryText}" />
        <CheckBox x:Name="KeepAudio"
                  Margin="0,12,0,0"
                  Content="Keep the audio"
                  Foreground="{DynamicResource PrimaryText}" />
        <TextBlock Margin="25,2,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}"
                   Text="Saves a copy with your Waypoint data. Without it, only the transcript is kept. Your own file is never changed or deleted." />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Padding="14,6" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="GoButton" Padding="14,6" Click="OnGoClicked" />
        </StackPanel>
    </StackPanel>
</Window>
