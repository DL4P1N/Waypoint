<Window x:Class="Waypoint.App.PickDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a date"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{DynamicResource Rule}"
        BorderThickness="1"
        Style="{StaticResource AppWindow}">
    <StackPanel Width="294" Margin="18">
        <TextBlock x:Name="ItemTitle"
                   Margin="0,0,0,12"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}" />
        <WrapPanel x:Name="QuickDays" Margin="0,0,0,12" />
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource SmallButton}"
                    Content="‹"
                    FontSize="16"
                    AutomationProperties.Name="Previous month"
                    Click="OnPreviousMonth" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SmallButton}"
                    Content="›"
                    FontSize="16"
                    AutomationProperties.Name="Next month"
                    Click="OnNextMonth" />
            <TextBlock x:Name="MonthLabel"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" />
        </DockPanel>
        <UniformGrid x:Name="DayNames" Columns="7" Margin="0,0,0,4" />
        <UniformGrid x:Name="Days" Columns="7" Rows="6" />
        <TextBox x:Name="TimeBox"
                 Margin="0,12,0,0"
                 Style="{StaticResource FieldBox}"
                 Tag="Time, optional (5:30 PM)"
                 AutomationProperties.Name="Time, optional" />
        <TextBlock x:Name="Problem"
                   AutomationProperties.LiveSetting="Polite"
                   Margin="0,6,0,0"
                   FontSize="13"
                   Text="Try a time like 5:30 PM."
                   Foreground="{DynamicResource SecondaryText}"
                   Visibility="Collapsed" />
        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="14,6" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="GoButton" Padding="14,6" Content="Move" IsDefault="True" Click="OnMoveClicked" />
        </StackPanel>
    </StackPanel>
</Window>
