<UserControl x:Class="Waypoint.App.NestedColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="210">
    <Border BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="16,22,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Square, as tall as the search box. The + is drawn rather than typed, since a font's + sits off center. -->
                <Button x:Name="AddButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="0"
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                        BorderBrush="{DynamicResource Rule}"
                        Click="OnAddClicked">
                    <Path Data="M 5,0 L 5,10 M 0,5 L 10,5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"
                          SnapsToDevicePixels="True"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Button>
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource FieldBox}"
                         Tag="Search"
                         AutomationProperties.Name="Search"
                         TextChanged="OnSearchChanged"
                         PreviewKeyDown="OnSearchKey" />
            </Grid>
            <TextBlock x:Name="Problem"
                       AutomationProperties.LiveSetting="Polite"
                       DockPanel.Dock="Bottom"
                       Margin="24,8,16,22"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryText}"
                       Visibility="Collapsed" />
            <ListBox x:Name="Entries"
                     Margin="10,0"
                     Style="{StaticResource PlainList}"
                     AllowDrop="True"
                     SelectionChanged="OnEntryPicked"
                     LostKeyboardFocus="OnEntriesLeft"
                     PreviewKeyDown="OnEntriesKey"
                     PreviewMouseLeftButtonDown="OnEntriesPressed"
                     PreviewMouseMove="OnEntriesMouseMove"
                     DragOver="OnEntriesDragOver"
                     DragLeave="OnEntriesDragLeave"
                     Drop="OnEntriesDrop"
                     ContextMenuOpening="OnEntriesMenuOpening">
                <!-- A row as everywhere else, with a divider and a group's name above it, outside its highlight, so a picked
                     entry is lit on its own and the group's name reads as the group's, not the entry's. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PickRow}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <StackPanel Background="Transparent">
                                        <Border Height="1"
                                                Margin="0,0,0,1"
                                                Background="{DynamicResource Rule}"
                                                Visibility="{Binding RuleVisibility}" />
                                        <!-- A group's name, such as Lists, above its first entry. Only a label: picking it picks that entry. -->
                                        <TextBlock Margin="14,8,11,0"
                                                   FontSize="12"
                                                   FontWeight="Normal"
                                                   IsHitTestVisible="False"
                                                   Text="{Binding Heading}"
                                                   Visibility="{Binding HeadingVisibility}"
                                                   Foreground="{DynamicResource SecondaryText}" />
                                        <Border x:Name="Row"
                                                Margin="0,0,0,2"
                                                Padding="11,8"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="3,0,0,0">
                                            <ContentPresenter />
                                        </Border>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface}" />
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="{Binding Indent}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Label}" />
                            <TextBlock FontSize="12"
                                       FontWeight="Normal"
                                       TextWrapping="Wrap"
                                       Text="{Binding Subtitle}"
                                       Visibility="{Binding SubtitleVisibility}"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
