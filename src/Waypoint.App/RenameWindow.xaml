<Window x:Class="Waypoint.App.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        SizeToContent="Height"
        Width="380"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{DynamicResource Rule}"
        BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="18">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="Light" Text="Rename" Foreground="{DynamicResource PrimaryText}" />
        <TextBox x:Name="NameBox"
                 Margin="0,12,0,0"
                 Style="{StaticResource FieldBox}"
                 AutomationProperties.Name="New name" />
        <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="14,6" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="DoneButton" Padding="14,6" Content="Rename" IsDefault="True" Click="OnRenameClicked" />
        </StackPanel>
    </StackPanel>
</Window>
