<UserControl x:Class="Waypoint.App.FindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Find anywhere, opened with Ctrl+K or the button under the pages. It stands in for the page until a result is picked or Esc. -->
    <DockPanel Margin="28,22,24,22">
        <Grid DockPanel.Dock="Top" MinHeight="34" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource ColumnTitle}" Text="Find anywhere" />
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource SmallButton}"
                    Content="Close"
                    ToolTip="Esc"
                    Click="OnCloseClicked" />
        </Grid>
        <TextBox x:Name="SearchBox"
                 DockPanel.Dock="Top"
                 Style="{StaticResource FieldBox}"
                 Tag="Search to-dos, lists, notes, History and purchases"
                 AutomationProperties.Name="Find anywhere"
                 TextChanged="OnSearchChanged"
                 PreviewKeyDown="OnSearchKey" />
        <TextBlock x:Name="Hint"
                   DockPanel.Dock="Top"
                   Margin="0,12,0,0"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryText}" />
        <ListBox x:Name="Results"
                 Margin="0,8,0,0"
                 Style="{StaticResource PlainList}"
                 ItemContainerStyle="{StaticResource PickRow}"
                 AutomationProperties.Name="Found"
                 PreviewKeyDown="OnResultsKey"
                 PreviewMouseLeftButtonUp="OnResultClicked">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Title}" />
                        <TextBlock FontSize="12" FontWeight="Normal" Text="{Binding Where}" Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
