<UserControl x:Class="Waypoint.App.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Waypoint.App"
             SizeChanged="OnSizeChanged">
    <!-- A PDF, slides, or document dropped anywhere on the page makes a new note from it. "Add a file" adds one to the open note instead. -->
    <Grid AllowDrop="True"
          PreviewDragEnter="OnFileDragOver"
          PreviewDragOver="OnFileDragOver"
          PreviewDragLeave="OnFileDragLeave"
          PreviewDrop="OnFileDrop">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ListColumn" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Notes dragged from the list land on a folder here, through the column's DataDropped. The lists sit below the folders. -->
        <local:NestedColumn x:Name="Column"
                            SearchHint="Search notes"
                            AddLabel="Add to Notes"
                            AddMode="Menu" />

        <Border x:Name="ListPane" Grid.Column="1" BorderBrush="{DynamicResource Rule}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- A class folder offers its practice questions here, not only on its right-click menu. -->
                <DockPanel DockPanel.Dock="Top" Margin="20,26,10,14">
                    <Button x:Name="StudyButton"
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SmallButton}"
                            Content="Study"
                            ToolTip="Make practice questions for an exam from this class's notes"
                            Visibility="Collapsed"
                            Click="OnStudyButtonClicked" />
                    <TextBlock x:Name="ListTitle"
                               Style="{StaticResource ColumnTitle}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="NoNotes"
                           DockPanel.Dock="Top"
                           Margin="20,0,16,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Text="No notes here."
                           Foreground="{DynamicResource SecondaryText}"
                           Visibility="Collapsed" />
                <Grid>
                    <ListBox x:Name="NotesList"
                             Margin="6,0,6,16"
                             Style="{StaticResource PlainList}"
                             ItemContainerStyle="{StaticResource PickRow}"
                             AutomationProperties.Name="Notes"
                             SelectionChanged="OnNotePicked"
                             LostKeyboardFocus="OnListLeft"
                             PreviewMouseLeftButtonDown="OnNotePressed"
                             PreviewMouseMove="OnNoteMouseMove"
                             ContextMenuOpening="OnNoteMenuOpening">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                    <TextBlock FontSize="12"
                                               FontWeight="Normal"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Line}"
                                               Foreground="{DynamicResource SecondaryText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="SpotsList"
                             Margin="6,0,6,16"
                             Style="{StaticResource PlainList}"
                             ItemContainerStyle="{StaticResource PickRow}"
                             AutomationProperties.Name="Saved spots"
                             Visibility="Collapsed"
                             SelectionChanged="OnSpotPicked"
                             LostKeyboardFocus="OnListLeft">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                    <TextBlock FontSize="12"
                                               FontWeight="Normal"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding Line}"
                                               Foreground="{DynamicResource SecondaryText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- A list picked in the column takes the place of the notes list and the note. -->
        <local:ListsView x:Name="ListsPanel"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Visibility="Collapsed" />

        <DockPanel x:Name="NoteSide" Grid.Column="2">
            <!-- In a narrow window the notes list steps aside while a note is open, so the note has room. This brings it back. -->
            <Button x:Name="ShowListButton"
                    DockPanel.Dock="Top"
                    Margin="24,16,24,0"
                    Padding="0,2"
                    Style="{StaticResource LinkButton}"
                    Content="‹ Show the notes list"
                    AutomationProperties.Name="Show the notes list"
                    Visibility="Collapsed"
                    Click="OnShowListClicked" />
            <local:UndoBar x:Name="Bar" DockPanel.Dock="Top" Margin="24,22,24,0" />
            <Grid>
                <TextBlock x:Name="NothingOpen"
                           Margin="24,28,24,0"
                           VerticalAlignment="Top"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Text="Pick a note, or start a new one with +. Drop a PDF or slides here to make notes from them."
                           Foreground="{DynamicResource SecondaryText}" />

                <DockPanel x:Name="Editor"
                           Margin="24,22,24,22"
                           Visibility="Collapsed"
                           LostKeyboardFocus="OnEditorLeft"
                           PreviewKeyDown="OnEditorKey">
                    <!-- Preview and Edit sit beside the title, where they're seen, not with the other buttons below. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="ModeButton"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                Content="Show Markdown"
                                ToolTip="Switch between the formatted note and its Markdown text (Ctrl+E)"
                                Click="OnModeClicked" />
                        <TextBox x:Name="TitleBox"
                                 Style="{StaticResource FieldBox}"
                                 FontSize="16"
                                 Tag="Title"
                                 AutomationProperties.Name="Note title"
                                 TextChanged="OnTextEdited" />
                    </DockPanel>
                    <!-- Says the notes were written from the sources, or that they're being written, or that writing failed. -->
                    <Border x:Name="StatusPanel"
                            DockPanel.Dock="Top"
                            Margin="0,0,0,10"
                            Padding="12,8"
                            Background="{DynamicResource Surface}"
                            Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="StatusButton"
                                        Margin="12,0,0,0"
                                        Padding="10,4"
                                        Click="OnStatusButtonClicked" />
                                <Button x:Name="StopButton"
                                        Margin="8,0,0,0"
                                        Padding="10,4"
                                        Content="Stop"
                                        Visibility="Collapsed"
                                        Click="OnStopClicked" />
                            </StackPanel>
                            <TextBlock x:Name="StatusText"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </DockPanel>
                    </Border>
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock x:Name="SavedLabel"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}" />
                        <!-- Wraps in a narrow window rather than cutting buttons off. -->
                        <WrapPanel x:Name="NoteButtons" HorizontalAlignment="Right">
                            <!-- Offers one concrete first step on a study note, through the usual Start session. -->
                            <Button x:Name="StudyStartButton"
                                    Margin="0,0,8,0"
                                    Padding="10,4"
                                    Content="Start with question 1"
                                    ToolTip="Start a session on this exam, beginning with question 1"
                                    Visibility="Collapsed"
                                    Click="OnStudyStartClicked" />
                            <!-- Kept audio is what lets a transcript line play from its moment. A choice made per note. -->
                            <Button x:Name="AudioButton"
                                    Margin="0,0,8,0"
                                    Padding="10,4"
                                    Visibility="Collapsed"
                                    Click="OnAudioClicked" />
                            <Button x:Name="AttachButton"
                                    Margin="0,0,8,0"
                                    Padding="10,4"
                                    Content="Add a file"
                                    ToolTip="Add a PDF, slides, or a document to this note's sources"
                                    Click="OnAttachClicked" />
                            <Button Padding="10,4" Content="Delete note" Click="OnDeleteClicked" />
                        </WrapPanel>
                    </Grid>

                    <!-- The original text of every file the note was made from. Closed each time a note opens, so only the notes show. -->
                    <Expander x:Name="SourcesSection"
                              DockPanel.Dock="Bottom"
                              Margin="0,8,0,0"
                              Visibility="Collapsed">
                        <Expander.Header>
                            <TextBlock x:Name="SourcesHeader"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}" />
                        </Expander.Header>
                        <DockPanel>
                        <!-- Play and pause for a transcript line that was clicked. Only shown once something has played. -->
                        <StackPanel x:Name="PlaybackBar"
                                    DockPanel.Dock="Top"
                                    Margin="12,4,4,4"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Button x:Name="PlayPauseButton"
                                    Padding="10,2"
                                    Content="Pause"
                                    Click="OnPlayPauseClicked" />
                            <Button Margin="8,0,0,0"
                                    Padding="10,2"
                                    Content="Stop"
                                    AutomationProperties.Name="Stop playing"
                                    Click="OnStopPlaybackClicked" />
                            <TextBlock x:Name="PlaybackText"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SourcesList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="12,0,4,0">
                                            <Expander.Header>
                                                <TextBlock FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Heading}"
                                                           Foreground="{DynamicResource PrimaryText}" />
                                            </Expander.Header>
                                            <StackPanel>
                                                <TextBox Padding="0"
                                                         MaxHeight="220"
                                                         FontSize="12"
                                                         IsReadOnly="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Visibility="{Binding TextVisibility}"
                                                         Text="{Binding Text, Mode=OneWay}"
                                                         Foreground="{DynamicResource SecondaryText}"
                                                         SelectionBrush="{DynamicResource Accent}"
                                                         AutomationProperties.Name="{Binding Heading}" />
                                                <!-- Said once, when the audio wasn't kept, so the times aren't mistaken for broken links. -->
                                                <TextBlock Margin="0,2,0,6"
                                                           FontSize="12"
                                                           FontStyle="Italic"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding LinesNote}"
                                                           Visibility="{Binding LinesNoteVisibility}"
                                                           Foreground="{DynamicResource SecondaryText}" />
                                                <ItemsControl Focusable="False"
                                                              Visibility="{Binding LinesVisibility}"
                                                              ItemsSource="{Binding Lines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button HorizontalContentAlignment="Stretch"
                                                                    Padding="0,1"
                                                                    Focusable="{Binding Playable}"
                                                                    IsHitTestVisible="{Binding Playable}"
                                                                    ToolTip="{Binding Hint}"
                                                                    AutomationProperties.Name="{Binding Name}"
                                                                    Click="OnLineClicked">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Frame" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <DockPanel>
                                                                    <TextBlock x:Name="Stamp"
                                                                               DockPanel.Dock="Left"
                                                                               MinWidth="52"
                                                                               FontSize="12"
                                                                               Text="{Binding Stamp}"
                                                                               Foreground="{DynamicResource SecondaryText}" />
                                                                    <TextBlock x:Name="Said"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap"
                                                                               Text="{Binding Text}"
                                                                               Foreground="{DynamicResource SecondaryText}" />
                                                                </DockPanel>
                                                            </Button>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Playable}" Value="True">
                                                                    <Setter TargetName="Stamp" Property="Foreground" Value="{DynamicResource Accent}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter TargetName="Said" Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                                                    <Setter TargetName="Said" Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </DockPanel>
                    </Expander>

                    <!-- Asks for different notes. They're always rewritten from the sources, never from the text above. -->
                    <DockPanel x:Name="ChangePanel"
                               DockPanel.Dock="Bottom"
                               Margin="0,10,0,0"
                               Visibility="Collapsed">
                        <!-- The same small row action as Add and Skip below it, and as the other rows' actions. -->
                        <Button x:Name="ChangeButton"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SmallButton}"
                                Content="Rewrite"
                                Click="OnChangeClicked" />
                        <TextBox x:Name="ChangeBox"
                                 Style="{StaticResource FieldBox}"
                                 FontSize="13"
                                 Tag="Ask for a change, like make these shorter or add more on recursion"
                                 AutomationProperties.Name="Change to ask for"
                                 KeyDown="OnChangeKey" />
                    </DockPanel>

                    <!-- Dates and tasks the files mention. Each waits for Add or Skip, and nothing is added on its own. -->
                    <StackPanel x:Name="SuggestionsPanel"
                                DockPanel.Dock="Bottom"
                                Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="Found in the files. Nothing goes on To do unless you choose Add."
                                   Foreground="{DynamicResource SecondaryText}" />
                        <ItemsControl x:Name="SuggestionsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SmallButton}"
                                                Content="Skip"
                                                AutomationProperties.Name="{Binding SkipName}"
                                                Click="OnSuggestionSkipped" />
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource SmallButton}"
                                                Content="Add"
                                                AutomationProperties.Name="{Binding AddName}"
                                                Click="OnSuggestionAdded" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Text}"
                                                   Foreground="{DynamicResource PrimaryText}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <local:NoteToolbar x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,0,0,8" />
                    <Grid>
                        <!-- The note as it will read: bold, headings, and lists show as formatting, with no Markdown marks. -->
                        <local:MarkdownBox x:Name="BodyBox"
                                           Style="{StaticResource RichFieldBox}"
                                           Padding="10,10,6,10"
                                           Background="Transparent"
                                           BorderBrush="{DynamicResource Rule}"
                                           BorderThickness="1"
                                           Foreground="{DynamicResource PrimaryText}"
                                           CaretBrush="{DynamicResource Accent}"
                                           SelectionBrush="{DynamicResource Accent}"
                                           AutomationProperties.Name="Note text"
                                           VerticalScrollBarVisibility="Auto"
                                           TextEdited="OnBodyEdited"
                                           Visibility="Collapsed" />
                        <TextBlock x:Name="BodyHint"
                                   Margin="16,11,12,0"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   IsHitTestVisible="False"
                                   Text="Write anything. Type # then a space for a heading, - for a list, or **bold** for bold."
                                   Foreground="{DynamicResource SecondaryText}"
                                   Visibility="Collapsed" />
                        <!-- The note's Markdown text, for editing the marks directly. Ctrl+E switches to it. -->
                        <local:MarkdownSourceBox x:Name="SourceBox"
                                                 Style="{StaticResource RichFieldBox}"
                                                 Padding="10,10,6,10"
                                                 Background="Transparent"
                                                 BorderBrush="{DynamicResource Rule}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource PrimaryText}"
                                                 CaretBrush="{DynamicResource Accent}"
                                                 SelectionBrush="{DynamicResource Accent}"
                                                 AutomationProperties.Name="Note Markdown text"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextEdited="OnBodyEdited"
                                                 Visibility="Collapsed" />
                    </Grid>
                </DockPanel>

                <ScrollViewer x:Name="SpotView"
                              Margin="24,22,24,22"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SpotProject"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PrimaryText}" />
                        <TextBlock x:Name="SpotWhen"
                                   Margin="0,2,0,14"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}" />
                        <ItemsControl x:Name="SpotParts" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Heading}"
                                                   Foreground="{DynamicResource SecondaryText}" />
                                        <TextBox Margin="0,4,0,0"
                                                 Padding="0"
                                                 FontSize="14"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Text="{Binding Text, Mode=OneWay}"
                                                 Foreground="{DynamicResource PrimaryText}"
                                                 SelectionBrush="{DynamicResource Accent}"
                                                 AutomationProperties.Name="{Binding Heading}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="SpotNextButton"
                                Margin="0,0,0,14"
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                Content="Add the next step"
                                ToolTip="What to do first when you come back to this"
                                Visibility="Collapsed"
                                Click="OnSpotNextClicked" />
                        <TextBlock FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Saved spots come from Save my spot."
                                   Foreground="{DynamicResource SecondaryText}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
