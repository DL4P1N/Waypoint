<Window x:Class="Waypoint.App.DeleteFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete folder"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        BorderBrush="{DynamicResource Rule}"
        BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <StackPanel Margin="18">
        <TextBlock x:Name="Question"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryText}" />
        <TextBlock Margin="0,6,0,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Text="Notes are never deleted with a folder. Folders inside it move up a level."
                   Foreground="{DynamicResource SecondaryText}" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="14,6" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
            <Button x:Name="ToParentButton" Padding="14,6" Margin="0,0,8,0" Click="OnToParentClicked" Visibility="Collapsed" />
            <Button x:Name="ToUnfiledButton" Padding="14,6" Content="Move them to Unfiled" IsDefault="True" Click="OnToUnfiledClicked" />
        </StackPanel>
    </StackPanel>
</Window>
