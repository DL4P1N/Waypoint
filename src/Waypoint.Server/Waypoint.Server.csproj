<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>waypoint-server</AssemblyName>
    <RootNamespace>Waypoint.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Waypoint.Core\Waypoint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tells systemd when the service is ready and writes logs in the journal's format. Does nothing elsewhere. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
  </ItemGroup>

</Project>
